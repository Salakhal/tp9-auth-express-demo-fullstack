# Serveur
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/auth_demo
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/auth_demo

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sessions
SESSION_SECRET=your_super_secret_session_key_change_me

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRY=15m

# Refresh Token
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_change_me
REFRESH_TOKEN_EXPIRY=7d

# CORS (Production)
CORS_ORIGIN=https://votre-domaine.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100